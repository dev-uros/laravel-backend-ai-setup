# Production environment. Copy to .env.production ON THE SERVER and fill in.
#
#   cp .env.production.example .env.production
#   make prod-key          # prints an APP_KEY to paste below
#   ./deploy.sh
#
# .env.production is gitignored and dockerignored: it never enters an image and
# never reaches the repository. It is read twice -- by compose, to fill in
# ${API_DOMAIN} and friends, and by the containers, as their environment.
#
# NO ${VARIABLE} REFERENCES IN HERE. Compose passes these lines to containers
# verbatim, so APP_URL=https://${API_DOMAIN} would arrive at PHP as that literal
# string. Write every value out in full.

# --- Domain ------------------------------------------------------------------
# Where Traefik routes this API. Must resolve to this server before the first
# deploy, or the ACME challenge fails and you burn one of five weekly
# certificate attempts.
#
# Only this application's domain lives here. ACME_EMAIL, the Grafana domain and
# the log retention belong to the shared infrastructure stack (/opt/infra),
# because they are not this application's to decide.
API_DOMAIN=api.example.com

# --- Application -------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=production
# Generate with `make prod-key`. Losing it makes every encrypted column and
# every signed URL unreadable -- keep a copy somewhere other than this server.
APP_KEY=
# Never true here. deploy.sh refuses to run otherwise: APP_DEBUG=true serves a
# stack trace containing environment variables to whoever triggers the error.
APP_DEBUG=false
APP_URL=https://api.example.com

# The separate SPA. Activation and password-reset emails link here, and it is
# the only origin CORS lets call this API from a browser.
FRONTEND_URL=https://app.example.com
# Only if a second origin needs in (a preview build, a staging SPA).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# Maintenance mode is held in Redis, not on disk. deploy.sh switches it on
# around migrations, and each container has its own filesystem -- a file-based
# flag set in one of them would leave the other three serving traffic.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# --- Logs --------------------------------------------------------------------
# JSON on stderr, which php-fpm forwards to the container log undecorated and
# Alloy scrapes into Loki. storage/logs/laravel.log is not used.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
# debug here means paying by the gigabyte for every Log::debug in every package.
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# postgres resolves on the internal compose network. Nothing is published to the
# host, so there is no port to firewall.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
# Long and random. `openssl rand -base64 32` will do.
DB_PASSWORD=

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Required, not optional: deploy.sh refuses an empty one. Redis has no other
# access control, and one misconfigured firewall rule is all it takes.
REDIS_PASSWORD=
# Separate logical databases so `cache:clear` can never drop queued jobs.
REDIS_DB=0
REDIS_CACHE_DB=1
# The cache runs on its own server. maxmemory is per instance and not per
# database, so sharing one would let the cache fill the queue's ceiling and --
# under noeviction -- start failing dispatch(). Leave this pointing at
# `redis-cache`; unset, it falls back to REDIS_HOST and they share again.
REDIS_CACHE_HOST=redis-cache
# Raise with the RAM you have. The eviction policy is noeviction (see
# compose.prod.yaml), so this is a ceiling that errors rather than one that
# quietly discards queued jobs.
REDIS_MAXMEMORY=512mb
# The cache server evicts (allkeys-lru), so this ceiling costs cold keys rather
# than errors. Both servers share REDIS_PASSWORD.
REDIS_CACHE_MAXMEMORY=256mb

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail --------------------------------------------------------------------
# Activation links, password resets and the resend endpoint all go through here.
# MAIL_MAILER=log would make account creation look like it works and quietly
# strand every new user, so deploy.sh warns when it sees it.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# `smtp` or `smtps`, and nothing else: these are the only two schemes Symfony's
# EsmtpTransportFactory accepts, and anything else throws UnsupportedSchemeException
# on every send -- activation and password-reset mail included. `smtps` is implicit
# TLS (port 465); `smtp` is plain or STARTTLS (587, 25). Left empty, Laravel picks
# one from MAIL_PORT, which is also correct.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Laravel

# --- Backups -----------------------------------------------------------------
# deploy.sh dumps the database before every migration. Older dumps than this are
# deleted; see `make backup` and the cron line in docker/scripts/backup.sh.
BACKUP_KEEP_DAYS=14

# --- Sizing ------------------------------------------------------------------
# Everything below has a default sized for a server with room to spare (8 GB).
# LEAVE IT ALL COMMENTED OUT unless this machine is smaller -- the defaults live
# in compose.prod.yaml and config/horizon.php, and an override here is how one
# repository serves a small server and a large one without a code change.
#
# What actually consumes the memory is the process count, not the limits: each
# php-fpm worker and each Horizon process is a PHP interpreter at a realistic
# 60-80 MB. The limits below are ceilings that must be raised or lowered WITH
# the counts -- a lowered ceiling alone gets workers OOM killed, a raised one
# alone buys nothing.
#
# Worked example, a 4 GB box running the API, the log stack and nothing else:
#
#   PHP_FPM_MAX_CHILDREN=5          #  5 x ~70 MB + 128 MB opcache  ~ 480 MB
#   HORIZON_MAX_PROCESSES=3         #  3 x ~70 MB + 128 MB opcache  ~ 340 MB
#   PHP_OPCACHE_MEMORY=128
#   PHP_MEM_LIMIT=640m
#   HORIZON_MEM_LIMIT=448m
#   SCHEDULER_MEM_LIMIT=256m
#   NGINX_MEM_LIMIT=96m
#   PG_MEM_LIMIT=768m
#   PG_SHARED_BUFFERS=192MB
#   PG_EFFECTIVE_CACHE_SIZE=768MB   # a planner hint, not an allocation -- see below
#   PG_WORK_MEM=8MB
#   PG_MAINTENANCE_WORK_MEM=64MB
#   PG_SHM_SIZE=128mb
#   REDIS_MEM_LIMIT=192m
#   REDIS_CACHE_MEM_LIMIT=160m
#
# and REDIS_MAXMEMORY / REDIS_CACHE_MAXMEMORY above lowered to match (128mb/96mb).
# That comes to roughly 2 GB of ceilings, leaving room for Traefik, the log stack
# and the operating system.
#
# PG_EFFECTIVE_CACHE_SIZE allocates nothing: it tells the query planner how much
# OS cache it may assume. Leaving the 2GB default on a 4 GB box shared with PHP
# and Redis is not a memory problem but a planning one -- the planner keeps
# choosing index scans on the strength of cache that is not there.

# --- Database client access --------------------------------------------------
# Postgres is published on 127.0.0.1 only (compose.prod.yaml), for a client
# reaching it over an SSH tunnel. Change the host port here if 5432 is taken on
# the server -- the container side is always 5432.
# DB_HOST_PORT=5432
