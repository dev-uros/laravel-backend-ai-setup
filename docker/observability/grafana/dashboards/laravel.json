{
  "uid": "laravel-requests",
  "title": "Laravel — zahtevi i jobovi",
  "description": "Sve u ovom pregledu čita JSON linije koje pišu LogRequests i JobLogger. Nema Prometheusa: brojevi su izvedeni iz samih logova.",
  "tags": [
    "laravel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Projekat",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "project",
          "refId": "project",
          "type": 1
        },
        "refresh": 1,
        "current": {},
        "includeAll": false
      },
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Zalepi request_id iz odgovora (X-Request-Id) da vidiš ceo put tog zahteva, uključujući i job koji je pokrenuo."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Zahteva",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({project=\"$project\", service=\"php\"} | json | message=\"request\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Serverskih grešaka (5xx)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({project=\"$project\", service=\"php\"} | json | message=\"request\" | context_status >= 500 [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Odbijenih (401 / 403)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({project=\"$project\", service=\"php\"} | json | message=\"request\" | context_status =~ \"401|403\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobova obrađeno",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({project=\"$project\", service=~\"horizon|php\"} | json | message=\"job\" | context_outcome=\"processed\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Jobova palo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({project=\"$project\", service=~\"horizon|php\"} | json | message=\"job\" | context_outcome=\"failed\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Zahtevi u minutu, po nivou",
      "description": "INFO je uobičajen saobraćaj, WARNING su 401/403/429, ERROR je 5xx.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({project=\"$project\", service=\"php\"} | json | message=\"request\" [1m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencija po ruti (p95, 5m)",
      "description": "Grupisano po `route` (obrascu rute), ne po putanji — /api/users/12 i /api/users/13 su ista stvar.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {project=\"$project\", service=\"php\"} | json | message=\"request\" | context_route != \"\" | unwrap context_duration_ms [5m]) by (context_route)",
          "legendFormat": "{{context_route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Greške i upozorenja",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=\"$project\", service=~\"php|horizon|scheduler\", level=~\"WARNING|ERROR|CRITICAL\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Trag jednog zahteva — upiši Request ID gore",
      "description": "Zahtev i svaki job koji je iz njega proistekao, iz oba kontejnera, po jednom id-u.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=\"$project\", service=~\"php|horizon|scheduler\"} |= `$request_id`"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Poslednji zahtevi",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=\"$project\", service=\"php\"} | json | message=\"request\" | line_format \"{{.context_method}} {{.context_route}} -> {{.context_status}} ({{.context_duration_ms}}ms) user={{.context_user_id}} id={{.context_request_id}}\""
        }
      ]
    }
  ]
}
