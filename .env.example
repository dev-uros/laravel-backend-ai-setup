APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Root of the separate frontend app. Activation and reset links point here,
# and it is the only origin CORS lets call this API from a browser.
FRONTEND_URL=http://localhost:5173

# Only if a second origin needs in (staging, preview build). Comma-separated
# list of origins; overrides FRONTEND_URL for CORS when set.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
# JSON on stderr: php-fpm forwards it to the container log undecorated
# (catch_workers_output), which is what a Loki agent scrapes.
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Separate logical databases so `cache:clear` never drops queued jobs.
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Docker (local development) ---------------------------------------------
# Ports published on the host. Change these if something already uses them.
APP_PORT=8000
FORWARD_DB_PORT=5433
FORWARD_TEST_DB_PORT=5434
FORWARD_REDIS_PORT=6379

# The php/horizon containers run as this uid:gid so files written into the
# bind mount stay owned by you on the host. `make` overrides these with your
# real id -u / id -g, so you only need to touch them for a raw `docker compose`.
WWWUSER=1000
WWWGROUP=1000

# Local observability stack (compose.observability.yaml, started with `make observe`).
GRAFANA_PORT=3000
ALLOY_PORT=12345
